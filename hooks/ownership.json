{
  "_doc": "Per-agent permissions enforced by scripts/guard.py. Agents not listed here are not restricted by this guard. 'write': glob patterns relative to the project root that the agent may write; 'write_except': globs it may never write ('!pattern' re-includes); 'write_if_conflicted': may edit files that contain merge-conflict markers; 'bash': regexes for SDD commands the agent may run (git, gh, the trace script, \u2026); 'project_commands': purposes from the `commands:` section of the project's committed .sdd/stack.yaml the agent may run (the registry follows the project's stack; a global denylist always applies); chaining and redirection are always denied; 'mcp': 'read-only' denies MCP tools whose name looks like a write. '__hub__' lists the main session's bookkeeping actions that are auto-approved; everything else in the main session keeps normal prompts. In-policy actions are auto-approved unless .sdd/config.yaml sets permissions.auto_approve: false.",
  "__hub__": {
    "write": [
      "specs/*/state.yaml",
      "specs/*/decisions.md",
      ".sdd/stack.yaml",
      ".sdd/constitution.md",
      ".sdd/config.yaml"
    ],
    "bash": [
      "(rtk )?uv run (-q )?\"?/\\S+?/skills/sdd-contracts/scripts/sdd\\.py\"? (trace|stale|expected-failing)( [^<>$]*)?",
      "git (status|log|diff|show)( [^<>$;&|`]*)?",
      "git branch( (-a|-r|-v|-vv|--list|--show-current|--merged|--no-merged)[^<>$;&|`]*)?",
      "git add( (specs|\\.sdd|docs|README\\.md)[\\w./-]*)+",
      "git commit( -m \\\"chore\\(sdd\\)[^\\\"$`]*\\\")( -m \\\"[^\\\"$`]*\\\")*",
      "git switch (-c )?sdd/[\\w./-]+( [\\w./-]+)?",
      "git fetch( --prune)?( origin)?",
      "git remote( -v)?",
      "git worktree (list|prune)",
      "git worktree remove (--force )?\\.claude/worktrees/agent-[\\w-]+",
      "git branch -D worktree-agent-[\\w-]+"
    ]
  },
